    {
      "name": "Stock Meter",
      "kind": "custom",
      "description": "Days of stock on site with a computed tag.",
      "html": "<div class=\"ds-stk\"><em>Diesel</em><span class=\"ds-trk\"><i style=\"width:23%\"></i></span><b>1.4 d</b><span class=\"ds-tag2\">computed</span></div>",
      "css": ".ds-stk{display:grid;grid-template-columns:64px 120px auto auto;align-items:center;gap:8px;font-family:Archivo,system-ui,sans-serif;font-size:12px;font-variant-numeric:tabular-nums;color:#1d1a17}.ds-stk em{font-style:normal;color:#554e47;font-stretch:94%}.ds-trk{height:6px;border-radius:3px;background:#e4ddd2;position:relative;overflow:hidden}.ds-trk i{position:absolute;left:0;top:0;bottom:0;background:#1d1a17;border-radius:3px}.ds-stk b{font-weight:680}.ds-tag2{height:16px;padding:0 5px;border-radius:3px;background:#efe9df;font-size:10px;font-weight:600;color:#554e47;display:inline-flex;align-items:center}"
