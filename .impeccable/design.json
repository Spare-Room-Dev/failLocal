  "components": [
    {
      "name": "Service Card",
      "kind": "card",
      "refersTo": "service-card",
      "description": "Outside service cabled into the board; Cut on the right.",
      "html": "<div class=\"ds-svc\"><svg class=\"ds-ico\" viewBox=\"0 0 32 32\" width=\"30\" height=\"30\"><path d=\"M9 22h15a5 5 0 0 0 .6-10 7 7 0 0 0-13.5-1.6A5.8 5.8 0 0 0 9 22z\" fill=\"#faf8f4\" stroke=\"#1d1a17\" stroke-width=\"1.5\" stroke-linejoin=\"round\"/></svg><div><b>Cloud login</b><span class=\"ds-st\">Up</span></div><button class=\"ds-cut\" aria-pressed=\"false\">Cut</button></div>",
      "css": ".ds-svc{display:grid;grid-template-columns:30px 1fr auto;align-items:center;gap:8px;width:240px;height:58px;padding:0 8px 0 9px;background:#faf8f4;border:1px solid #c4bbad;border-radius:6px;box-shadow:0 1px 0 rgba(29,26,23,.04),0 6px 14px -8px rgba(60,40,25,.25);font-family:Archivo,system-ui,sans-serif;color:#1d1a17}.ds-svc b{display:block;font-size:13px;font-weight:680;font-stretch:88%;line-height:1.15}.ds-st{font-size:11.5px;color:#554e47;font-stretch:94%}.ds-cut{height:28px;padding:0 8px;border:1px solid #c4bbad;border-radius:5px;background:#faf8f4;font:inherit;font-size:12px;font-weight:650;cursor:pointer}.ds-cut:hover{border-color:#1d1a17;background:#fff}.ds-cut:focus-visible{outline:2px solid #1d1a17;outline-offset:2px}"
    },
    {
      "name": "Service Card, Cut",
      "kind": "card",
      "refersTo": "service-card-cut",
      "description": "Cut state: dashed ink border, slashed icon, red status, Restore.",
      "html": "<div class=\"ds-svc-cut\"><svg viewBox=\"0 0 32 32\" width=\"30\" height=\"30\"><rect x=\"8\" y=\"5\" width=\"15\" height=\"20\" rx=\"1.5\" fill=\"#faf8f4\" stroke=\"#1d1a17\" stroke-width=\"1.5\"/><path d=\"M4 28L28 4\" stroke=\"#b3261e\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg><div><b>Hosted ERP</b><span>Cut since day 0</span></div><button class=\"ds-restore\" aria-pressed=\"true\">Restore</button></div>",
      "css": ".ds-svc-cut{display:grid;grid-template-columns:30px 1fr auto;align-items:center;gap:8px;width:240px;height:58px;padding:0 8px 0 9px;background:#f6f1ea;border:1px dashed #1d1a17;border-radius:6px;font-family:Archivo,system-ui,sans-serif;color:#1d1a17}.ds-svc-cut b{display:block;font-size:13px;font-weight:680;font-stretch:88%}.ds-svc-cut span{font-size:11.5px;font-weight:650;color:#b3261e;font-stretch:94%}.ds-restore{height:28px;padding:0 8px;border:1px solid #1d1a17;border-radius:5px;background:#1d1a17;color:#faf8f4;font:inherit;font-size:12px;font-weight:650;cursor:pointer}.ds-restore:hover{background:#3a3430}.ds-restore:focus-visible{outline:2px solid #1d1a17;outline-offset:2px}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one hi-vis call to action on the landing page.",
      "html": "<a class=\"ds-btn-primary\" href=\"#\">Show me the site <svg width=\"18\" height=\"14\" viewBox=\"0 0 18 14\"><path d=\"M1 7h15M10.5 1.5L16 7l-5.5 5.5\" fill=\"none\" stroke=\"#1d1a17\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></a>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:10px;height:50px;padding:0 20px 0 22px;border-radius:7px;background:#f2b01e;color:#1d1a17;font-family:Archivo,system-ui,sans-serif;font-size:16px;font-weight:700;text-decoration:none;box-shadow:0 1px 0 rgba(29,26,23,.25),0 10px 22px -12px rgba(150,95,10,.55);transition:background .15s,transform .15s}.ds-btn-primary svg{transition:transform .2s cubic-bezier(.2,.8,.2,1)}.ds-btn-primary:hover{background:#e09d0c}.ds-btn-primary:hover svg{transform:translateX(3px)}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:2px solid #1d1a17;outline-offset:3px}"
    },
    {
      "name": "Provenance Tags",
      "kind": "chip",
      "refersTo": "tag-computed",
      "description": "Four kinds distinguished by border: computed, assumed, sourced, measured.",
      "html": "<span class=\"ds-tag ds-computed\">computed</span> <span class=\"ds-tag ds-assumed\">assumed</span> <span class=\"ds-tag ds-sourced\">sourced</span> <span class=\"ds-tag ds-measured\">measured</span>",
      "css": ".ds-tag{display:inline-flex;align-items:center;height:16px;padding:0 5px;border-radius:3px;font-family:Archivo,system-ui,sans-serif;font-size:10px;font-weight:600;letter-spacing:.02em;font-stretch:92%;color:#554e47;border:1px solid #c4bbad}.ds-computed{background:#efe9df;border-color:#efe9df}.ds-assumed{border-style:dashed}.ds-sourced{border-color:#6c645c}.ds-measured{border-color:#6c645c;border-width:1px 1px 2px}"
    },
    {
      "name": "Segmented Control",
