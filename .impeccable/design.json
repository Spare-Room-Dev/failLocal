      "css": ".ds-badge{display:inline-flex;align-items:center;gap:5px;height:24px;padding:0 8px;border:1px solid #1d1a17;border-radius:999px;font-family:Archivo,system-ui,sans-serif;font-size:12px;font-weight:600;font-stretch:94%;color:#1d1a17}.ds-dash{border-style:dashed}"
