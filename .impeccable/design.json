      "description": "Unprepared / Prepared site toggle.",
      "html": "<div class=\"ds-seg\"><button aria-pressed=\"true\">Unprepared</button><button aria-pressed=\"false\">Prepared</button></div>",
      "css": ".ds-seg{display:inline-flex;border:1px solid #c4bbad;border-radius:7px;padding:2px;background:#faf8f4;font-family:Archivo,system-ui,sans-serif}.ds-seg button{border:0;background:none;height:26px;padding:0 9px;border-radius:5px;font:inherit;font-size:12.5px;font-weight:600;color:#554e47;cursor:pointer}.ds-seg button[aria-pressed=\"true\"]{background:#1d1a17;color:#faf8f4}.ds-seg button:hover:not([aria-pressed=\"true\"]){background:#f3efe8;color:#1d1a17}.ds-seg button:focus-visible{outline:2px solid #1d1a17;outline-offset:2px}"
    },
