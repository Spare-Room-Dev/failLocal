{
  "name": "@faillocal/site",
  "version": "0.0.0",
  "private": true,
  "engines": { "node": "22.x" },
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "register": "node scripts/build-register.mjs",
    "predev": "npm run register",
    "dev": "vite",
    "prebuild": "npm run register",
    "build": "vite build && node scripts/check-build.mjs",
    "release": "npm run build && node scripts/release-check.mjs",
    "preview": "vite preview",
    "pretest": "npm run register",
    "test": "vitest run",
    "pretypecheck": "npm run register",
    "typecheck": "tsc --noEmit -p .",
    "e2e": "playwright test",
    "og-image": "node scripts/og-image.mjs"
  },
  "dependencies": {
    "@faillocal/engine": "*",
    "@fontsource-variable/archivo": "^5.3.0",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2"
  }
}
